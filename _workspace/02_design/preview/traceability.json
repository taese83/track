  "testCases": [
    {
      "testCaseId": "TC-001-1",
      "given": "유효한 view/XXXXXX 형식 링크",
      "when": "사용자가 제출하면",
      "then": "fetch에 성공하고 원본 응답이 파싱 단계로 전달된다."
    },
    {
      "testCaseId": "TC-001-2",
      "given": "형식이 view/XXXXXX와 다른 잘못된 URL",
      "when": "제출하면",
      "then": "\"유효하지 않은 링크입니다\" 메시지가 표시되고 재입력이 유도된다."
    },
    {
      "testCaseId": "TC-001-3",
      "given": "형식은 맞지만 존재하지 않는 트랙 코드",
      "when": "조회하면",
      "then": "\"트랙을 찾을 수 없습니다\" 메시지가 표시된다."
    },
    {
      "testCaseId": "TC-001-4",
      "given": "편집기 응답이 임계값(잠정)을 넘겨 지연되는 상태",
      "when": "조회가 진행 중이면",
      "then": "loading 인디케이터에 \"시간이 걸리고 있어요\" 안내가 추가된다."
    },
    {
      "testCaseId": "TC-001-5",
      "given": "편집기 서버가 5xx/timeout/network 오류를 반환",
      "when": "조회를 시도하면",
      "then": "원인이 구분된 에러 메시지와 재시도 버튼이 표시된다."
    },
    {
      "testCaseId": "TC-001-6",
      "given": "같은 탭에서 이미 한 번 불러온 트랙 코드",
      "when": "같은 코드를 다시 제출하면",
      "then": "클라이언트 세션 캐시에서 즉시 복원되고 네트워크 요청이 0건이다."
    },
    {
      "testCaseId": "TC-001-7",
      "given": "3D 표시 화면이 로드된 상태",
      "when": "화면을 확인하면",
      "then": "원본 편집기로의 출처 링크가 상시 노출된다."
    },
    {
      "testCaseId": "TC-001-8",
      "given": "동일 트랙 코드를 캐시 TTL 내에 다른 탭에서 조회",
      "when": "제출하면",
      "then": "x-vercel-cache 헤더가 HIT 또는 STALE이다."
    },
    {
      "testCaseId": "TC-002-1",
      "given": "정상 문법의 참조 트랙 원본 문자열",
      "when": "파싱을 수행하면",
      "then": "피스 객체(class, x, y, angle, color) 배열이 산출된다."
    },
    {
      "testCaseId": "TC-002-2",
      "given": "정의 문법과 어긋난 손상 문자열",
      "when": "파싱을 시도하면",
      "then": "파싱 실패 메시지가 표시되고 원본 응답 일부가 접이식 디버그 영역에 노출된다."
    },
    {
      "testCaseId": "TC-002-3",
      "given": "피스가 0개이거나 빈 문자열인 응답",
      "when": "파싱을 시도하면",
      "then": "파싱 실패로 처리되고 디버그 영역에 원본이 노출된다."
    },
    {
      "testCaseId": "TC-002-4",
      "given": "compat=false인 참조 트랙 응답",
      "when": "파싱하면",
      "then": "compat 플래그가 false로 기록되고 보정 메타데이터가 부여되지 않는다."
    },
    {
      "testCaseId": "TC-002-5",
      "given": "compat=true fixture(WS67Y2로는 검증 불가)",
      "when": "파싱하면",
      "then": "45/135/225/315° Cor1에 보정 메타데이터가 부여된다(skip 관리)."
    },
    {
      "testCaseId": "TC-003-1",
      "given": "파싱된 참조 트랙 피스 전체",
      "when": "끝점 매칭을 수행하면",
      "then": "Str2에서 시작하는 순서 배열이 산출된다."
    },
    {
      "testCaseId": "TC-003-2",
      "given": "동일 트랙 코드로 3회 반복 조회",
      "when": "매번 순서 복원을 수행하면",
      "then": "3회 모두 동일한 순서 배열이 산출된다."
    },
    {
      "testCaseId": "TC-003-3",
      "given": "여러 피스의 끝점 후보가 근접해 모호한 경우",
      "when": "매칭을 수행하면",
      "then": "위치·각도 오차가 최소인 후보를 결정적 규칙으로 선택한다."
    },
    {
      "testCaseId": "TC-003-4",
      "given": "Str2(START)가 0개인 피스 배열",
      "when": "순서 복원을 시도하면",
      "then": "\"시작 지점(START)을 찾을 수 없습니다\" 메시지와 디버그 노출, 3D 렌더는 시도하지 않는다."
    },
    {
      "testCaseId": "TC-003-5",
      "given": "Str2가 2개 이상 존재",
      "when": "순서 복원을 시도하면",
      "then": "최초 등장 피스를 시작점으로 선택하고 근거를 기록하며 나머지는 마커 직선으로 처리한다."
    },
    {
      "testCaseId": "TC-004-1",
      "given": "정상 폐곡선을 이루는 참조 트랙",
      "when": "폐곡선 검증을 수행하면",
      "then": "통과로 판정되고 경고 배너는 노출되지 않는다."
    },
    {
      "testCaseId": "TC-004-2",
      "given": "끝점이 어긋난 비폐곡선 데이터",
      "when": "파싱·순서복원이 완료되면",
      "then": "연결 가능한 구간은 정상 렌더, 끊긴 지점은 경고 배너와 함께 회색 표시되며 렌더링은 중단되지 않는다."
    },
    {
      "testCaseId": "TC-004-3",
      "given": "부분 실패 상태로 렌더된 화면",
      "when": "3D 뷰를 회전·확대하면",
      "then": "실패 구간은 회색·점선을 유지하고 정상 구간의 조작은 그대로 동작한다."
    },
    {
      "testCaseId": "TC-004-4",
      "given": "상승/하강 누적 고도가 START에서 상쇄되는 트랙",
      "when": "Z 폐합 검증을 수행하면",
      "then": "오차가 허용오차 이내로 판정되고 별도 경고가 노출되지 않는다."
    },
    {
      "testCaseId": "TC-004-5",
      "given": "XY는 폐곡선이지만 고도가 불균형한 데이터",
      "when": "Z 폐합 검증을 수행하면",
      "then": "수직 불연속 경고와 \"고도가 시작 지점과 어긋납니다\" 배너가 노출되고 강제 보정 없이 표시된다."
    },
    {
      "testCaseId": "TC-004-6",
      "given": "고도 폐합 실패 상태",
      "when": "프로파일 스트립을 표시하면",
      "then": "START/END 절대 고도 차이가 그래프 양 끝단의 수직 불연속으로 드러난다."
    },
    {
